            const resultBox = document.getElementById('belajar-result-box');
            resultBox.innerText = "?";
            resultBox.className = "w-20 h-20 md:w-24 md:h-24 bg-gradient-to-br from-amber-400 to-orange-500 rounded-2xl border-4 border-white shadow-lg flex items-center justify-center text-4xl md:text-5xl font-black text-white transform transition-transform";

