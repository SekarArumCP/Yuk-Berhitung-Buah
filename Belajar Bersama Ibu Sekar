        // Navigation between scenes
        function showScene(sceneId) {
            const scenes = ['scene-loading', 'scene-splash', 'scene-menu', 'scene-belajar', 'scene-bermain', 'scene-reward'];
            scenes.forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.add('hidden');
            });
            const target = document.getElementById(sceneId);
            if (target) target.classList.remove('hidden');
        }

        // Automatic simulated loading progress on app startup
        window.addEventListener('load', () => {
            let progress = 0;
            const loadingBar = document.getElementById('loading-bar');
            const loadingText = document.getElementById('loading-text');

            const loadingInterval = setInterval(() => {
                progress += Math.floor(Math.random() * 15) + 12;
                if (progress >= 100) {
                    progress = 100;
                    clearInterval(loadingInterval);
                    if (loadingBar) loadingBar.style.width = '100%';
                    if (loadingText) loadingText.innerText = '100%';

                    // Smooth transition to splash screen after loading completes
                    setTimeout(() => {
                        showScene('scene-splash');
                        speak("Halo teman-teman! Yuk belajar berhitung buah bersama!");
                    }, 500);
                } else {
                    if (loadingBar) loadingBar.style.width = progress + '%';
                    if (loadingText) loadingText.innerText = progress + '%';
                }
            }, 180);
        });

        function startApp() {
            initAudio();
            playPopSound(500);
            showScene('scene-menu');
            speak("Mau ngapain kita hari ini? Pilih tombol BELAJAR atau BERMAIN ya!");
        }

        function goHome() {
            playPopSound(400);
            showScene('scene-menu');
            speak("Mau ngapain kita hari ini? Pilih tombol BELAJAR atau BERMAIN ya!");
        }

        function openBelajar() {
            playPopSound(450);
            currentBelajarIdx = 0;
            showScene('scene-belajar');
            renderBelajarCard();
        }

        function renderBelajarCard() {
            const data = belajarData[currentBelajarIdx];
            document.getElementById('belajar-title').innerText = data.title;
            document.getElementById('belajar-step-indicator').innerText = `Materi ${currentBelajarIdx + 1} / ${belajarData.length}`;

