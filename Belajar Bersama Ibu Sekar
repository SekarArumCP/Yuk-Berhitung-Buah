            }

            // Render Group B
            const containerB = document.getElementById('belajar-group-b');
            containerB.innerHTML = '';
            for (let i = 0; i < data.countB; i++) {
                const fruitBtn = createFruitButton(data.fruit, data.countA + i + 1, data.nameSingular);
                containerB.appendChild(fruitBtn);
            }

            // Navigation Buttons State
            document.getElementById('btn-belajar-prev').disabled = (currentBelajarIdx === 0);

            // Audio Instruction
            const textPrompt = `Ada ${data.countA} ${data.nameSingular} ditambah ${data.countB} ${data.nameSingular}. Sentuh buahnya untuk menghitung!`;
            speak(textPrompt);
        }

        function createFruitButton(emoji, number, fruitName) {
            const btn = document.createElement('button');
            btn.className = "fruit-card w-14 h-14 md:w-18 md:h-18 bg-white rounded-2xl border-2 border-amber-300 shadow flex items-center justify-center text-3xl md:text-4xl active:scale-90 relative group";
            btn.innerHTML = `<span>${emoji}</span>`;
            
            btn.onclick = () => {
                playPopSound(300 + (number * 40));
                // Show floating number overlay
                const badge = document.createElement('span');
                badge.className = "absolute -top-2 -right-2 bg-amber-500 text-white font-extrabold text-xs md:text-sm w-6 h-6 rounded-full flex items-center justify-center shadow border border-white animate-pop";
                badge.innerText = number;
                btn.appendChild(badge);
                
                speak(`${number}`);
            };
            return btn;
        }

        function countBelajarAll() {
            const data = belajarData[currentBelajarIdx];
            let count = 1;
            const total = data.total;

            speak(`Mari hitung bersama!`);

            const interval = setInterval(() => {
                if (count <= total) {
                    playPopSound(300 + (count * 40));
                    speak(`${count}`);
                    count++;
                } else {
                    clearInterval(interval);
                    setTimeout(() => {
                        const resultBox = document.getElementById('belajar-result-box');
                        resultBox.innerText = total;
                        resultBox.classList.add('scale-110', 'bg-emerald-500');
                        playCorrectSound();
                        speak(`Hore! Semuanya ada ${total} ${data.nameSingular}!`);
                    }, 600);
                }
            }, 800);
        }

        function prevBelajar() {
            if (currentBelajarIdx > 0) {
                currentBelajarIdx--;
                playPopSound(350);
                renderBelajarCard();
            }
        }

        function nextBelajar() {
            if (currentBelajarIdx < belajarData.length - 1) {
                currentBelajarIdx++;
                playPopSound(450);
                renderBelajarCard();
            } else {
                openBermain();
            }
        }

        function openBermain() {
            playPopSound(500);
            currentQuizIdx = 0;
            quizStarsCount = 0;
            showScene('scene-bermain');
            renderQuizLevel();
        }

        function renderQuizLevel() {
            const data = quizData[currentQuizIdx];
            document.getElementById('quiz-level-text').innerText = `${currentQuizIdx + 1} / ${quizData.length}`;

            // Update Stars Display
            const starsContainer = document.getElementById('quiz-stars');
            starsContainer.innerHTML = '';
            for (let i = 0; i < quizData.length; i++) {
                const star = document.createElement('i');
                if (i < quizStarsCount) {
                    star.className = "fas fa-star text-amber-400 drop-shadow";
                } else {
                    star.className = "far fa-star text-amber-300 opacity-60";
                }
                starsContainer.appendChild(star);
            }

            // Render Group A
            const groupA = document.getElementById('quiz-group-a');
            groupA.innerHTML = '';
            for (let i = 0; i < data.countA; i++) {
                const f = createQuizFruitItem(data.fruit, i + 1);
                groupA.appendChild(f);
            }

            // Render Group B
            const groupB = document.getElementById('quiz-group-b');
            groupB.innerHTML = '';
            for (let i = 0; i < data.countB; i++) {
                const f = createQuizFruitItem(data.fruit, data.countA + i + 1);
                groupB.appendChild(f);
            }

            // Render Answer Baskets
            const optionsContainer = document.getElementById('quiz-options-container');
            optionsContainer.innerHTML = '';

            data.options.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = "btn-wood p-4 md:p-6 rounded-3xl flex flex-col items-center justify-center transform active:scale-95 transition-transform group relative overflow-hidden";
                btn.innerHTML = `
                    <div class="flex items-center space-x-1 mb-1 group-hover:scale-110 transition-transform">
                        <img src="keranjang buah.png" alt="Keranjang Buah" class="w-10 h-10 md:w-12 md:h-12 object-contain filter drop-shadow" onerror="this.onerror=null; this.parentNode.innerHTML='<svg viewBox=\\'0 0 200 190\\' class=\\'w-10 h-10 md:w-12 md:h-12 filter drop-shadow\\' xmlns=\\'http://www.w3.org/2000/svg\\'><path d=\\'M 35 100 C 35 25, 165 25, 165 100\\' fill=\\'none\\' stroke=\\'#78350f\\' stroke-width=\\'16\\' stroke-linecap=\\'round\\'/><path d=\\'M 35 100 C 35 25, 165 25, 165 100\\' fill=\\'none\\' stroke=\\'#d97706\\' stroke-width=\\'10\\' stroke-linecap=\\'round\\'/><ellipse cx=\\'100\\' cy=\\'100\\' rx=\\'68\\' ry=\\'16\\' fill=\\'#451a03\\'/><path d=\\'M 32 100 C 36 150, 55 175, 100 175 C 145 175, 164 150, 168 100 Z\\' fill=\\'#d97706\\' stroke=\\'#78350f\\' stroke-width=\\'5\\'/><path d=\\'M 34 118 C 60 132, 140 132, 166 118\\' fill=\\'none\\' stroke=\\'#92400e\\' stroke-width=\\'5\\'/><path d=\\'M 38 136 C 65 148, 135 148, 162 136\\' fill=\\'none\\' stroke=\\'#92400e\\' stroke-width=\\'5\\'/><ellipse cx=\\'100\\' cy=\\'100\\' rx=\\'70\\' ry=\\'16\\' fill=\\'none\\' stroke=\\'#78350f\\' stroke-width=\\'8\\'/><ellipse cx=\\'100\\' cy=\\'100\\' rx=\\'70\\' ry=\\'16\\' fill=\\'none\\' stroke=\\'#f59e0b\\' stroke-width=\\'5\\' stroke-dasharray=\\'10 6\\'/></svg>';">
                    </div>
                    <span class="text-3xl md:text-5xl font-black text-white drop-shadow-md">${opt}</span>
                `;
                btn.onclick = () => checkQuizAnswer(opt, btn);
                optionsContainer.appendChild(btn);
            });

            speak(`Berapa jumlah semua ${data.nameSingular} ini? Tekan angka di keranjang bawah ya!`);
        }

        function createQuizFruitItem(emoji, index) {
            const el = document.createElement('div');
            el.className = "w-12 h-12 md:w-16 md:h-16 bg-amber-50 rounded-2xl border-2 border-amber-200 shadow-sm flex items-center justify-center text-3xl md:text-4xl cursor-pointer hover:scale-110 active:scale-90 transition-transform";
            el.innerHTML = emoji;
            el.onclick = () => {
                playPopSound(300 + (index * 40));
                speak(`${index}`);
            };
            return el;
        }

        function checkQuizAnswer(selected, buttonElem) {
            const data = quizData[currentQuizIdx];

            if (selected === data.answer) {
                // Correct Answer!
                playCorrectSound();
                buttonElem.classList.add('ring-4', 'ring-emerald-400', 'bg-emerald-600');
                quizStarsCount++;
                
                // Trigger mini confetti
                confetti({
                    particleCount: 50,
                    spread: 60,
                    origin: { y: 0.7 }
                });

                speak(`Wah, kamu pintar sekali! Jawabannya benar ${data.answer}!`);

                setTimeout(() => {
                    currentQuizIdx++;
                    if (currentQuizIdx < quizData.length) {
                        renderQuizLevel();
                    } else {
                        showRewardScene();
                    }
                }, 1800);

            } else {
                // Wrong Answer
                playWrongSound();
                buttonElem.classList.add('animate-shake');
                setTimeout(() => buttonElem.classList.remove('animate-shake'), 500);

                speak(`Ups! Coba hitung lagi yuk, ada berapa buahnya?`);
            }
        }

        function showRewardScene() {
            showScene('scene-reward');
            playVictorySound();
            
            document.getElementById('reward-score-text').innerText = `${quizStarsCount} / ${quizData.length}`;

            // Big celebratory confetti shower
            const duration = 2.5 * 1000;
            const animationEnd = Date.now() + duration;
            const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };

            function randomInRange(min, max) {
                return Math.random() * (max - min) + min;
            }

            const interval = setInterval(function() {
                const timeLeft = animationEnd - Date.now();
                if (timeLeft <= 0) {
                    return clearInterval(interval);
                }
                const particleCount = 50 * (timeLeft / duration);
                confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));
                confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));
            }, 250);

            speak("Horeee! Kamu luar biasa! Sudah bisa berhitung buah dengan hebat!");
        }

        // Initialize Speech Voices when ready
        if ('speechSynthesis' in window) {
            window.speechSynthesis.onvoiceschanged = function() {
                // Preload voices
            };
